# The published build. Rebuilt by CI on every push; never committed.
dist/

__pycache__/
*.pyc
.DS_Store
Thumbs.db

# The bench's "Export full layout" dump. It is a snapshot of what the wall
# rules currently produce, for reading while marking a render up; nothing loads
# it, and a stale one is worse than none. art/tiles/overrides.json is the
# hand-written sheet and IS committed.
art/tiles/computed.json

# The handout for whoever is presenting. It prints the live address AND the
# seat token in plain text, so it is the one file in here that must never be
# committed: this repository may be public, and the token is what stops a
# stranger taking Assane. Regenerate it rather than storing it.
DEMO-LINKS.pdf


# The connecting-and-playing handout. No token in this one -- the join code is
# made fresh by the main screen every session -- but it carries the live
# address and page after page of screenshots: the artwork, the floor plan and
# the puzzles. That is the NDA material itself, and this repository may be
# public. Regenerate it rather than storing it.
CONNECTING-AND-PLAYING.pdf
